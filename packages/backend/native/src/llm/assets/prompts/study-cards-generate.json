{
  "name": "study.cards.generate",
  "action": "study.cards.generate",
  "model": "claude-sonnet-4-6",
  "optionalModels": [
    "claude-haiku-4-5",
    "claude-sonnet-4-6",
    "claude-opus-4-6"
  ],
  "config": {
    "frequencyPenalty": 0.3,
    "presencePenalty": 0.3,
    "temperature": 0.4,
    "topP": 0.9,
    "maxTokens": 8192
  },
  "messages": [
    {
      "role": "assistant",
      "template": "Output Language: {{language}}."
    },
    {
      "role": "user",
      "template": "{{#focus}}Focus on this topic within the notes:\n{{focus}}\n\n{{/focus}}{{>guarded_content}}"
    }
  ]
}
